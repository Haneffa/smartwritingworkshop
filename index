<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Writing Workshop — Dopamine Feedback Poll</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">
  
  <script src="https://cdn.tailwindcss.com"></script>
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            dopaYellow: '#FFD93D',
            dopaPink: '#FF6B9A',
            dopaBlue: '#6BCBFF',
            dopaGreen: '#6BCB77',
            dopaPurple: '#B19CFF',
            dopaCream: '#FFF9ED',
            dopaNavy: '#203A80',
            dopaCardBg: '#FFFFFF',
          },
          fontFamily: {
            heading: ['Poppins', 'sans-serif'],
            body: ['Nunito', 'sans-serif'],
          },
          boxShadow: {
            'pop': '0px 10px 0px 0px #203A80',
            'pop-sm': '0px 5px 0px 0px #203A80',
            'pop-active': '0px 2px 0px 0px #203A80',
            'glow-pink': '0px 15px 35px -5px rgba(255, 107, 154, 0.4)',
            'glow-yellow': '0px 15px 35px -5px rgba(255, 217, 61, 0.45)',
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #FFF9ED;
      color: #203A80;
      font-family: 'Nunito', sans-serif;
      overflow-x: hidden;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    
    h1, h2, h3, h4, .font-heading {
      font-family: 'Poppins', sans-serif;
    }

    .dopamine-bg-pattern {
      background-color: #FFF9ED;
      background-image: 
        radial-gradient(#FFD93D 1.8px, transparent 1.8px),
        radial-gradient(#6BCBFF 1.8px, #FFF9ED 1.8px);
      background-size: 48px 48px;
      background-position: 0 0, 24px 24px;
    }

    @keyframes wiggle {
      0%, 100% { transform: rotate(-3deg); }
      50% { transform: rotate(3deg); }
    }
    @keyframes floaty {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(2deg); }
    }
    @keyframes bounceSquish {
      0%, 100% { transform: scale(1, 1); }
      40% { transform: scale(1.15, 0.85); }
      70% { transform: scale(0.9, 1.1); }
    }
    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.92) translateY(12px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    .animate-wiggle { animation: wiggle 2.5s ease-in-out infinite; }
    .animate-float { animation: floaty 3s ease-in-out infinite; }
    .animate-squish:active { animation: bounceSquish 0.3s ease; }
    .animate-pop-in { animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }

    .tactile-btn {
      transition: all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .tactile-btn:hover {
      transform: translateY(-3px);
    }
    .tactile-btn:active {
      transform: translateY(3px);
    }

    .option-card.selected {
      background-color: #FFF3F7 !important;
      border-color: #FF6B9A !important;
      box-shadow: 0px 6px 0px 0px #FF6B9A !important;
      transform: translateY(-2px);
    }

    .popit-board {
      background: linear-gradient(145deg, #ffffff, #fff3e0);
      border: 4px solid #203A80;
      box-shadow: 0 12px 0 #203A80, 0 16px 25px rgba(32, 58, 128, 0.2);
    }

    .pop-bubble {
      position: relative;
      border-radius: 9999px;
      transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
      cursor: pointer;
      user-select: none;
      box-shadow: inset 0 -6px 0 rgba(0, 0, 0, 0.22), 0 6px 0 #203A80;
      border: 3px solid #203A80;
    }

    .pop-bubble:hover:not(.popped) {
      transform: translateY(-4px) scale(1.05);
      filter: brightness(1.08);
    }

    .pop-bubble:active:not(.popped) {
      transform: translateY(4px) scale(0.95);
      box-shadow: inset 0 4px 6px rgba(0,0,0,0.3);
    }

    .pop-bubble.popped {
      transform: translateY(3px) scale(0.93);
      box-shadow: inset 0 6px 10px rgba(0, 0, 0, 0.35), 0 2px 0 #203A80;
      opacity: 0.92;
      border-color: #203A80;
    }

    .pop-bubble.popped::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      background: radial-gradient(circle at center, transparent 35%, rgba(0,0,0,0.18) 100%);
      pointer-events: none;
    }

    .pop-bubble.popped-correct {
      border-color: #15803d !important;
    }

    .pop-bubble.popped-wrong {
      border-color: #be123c !important;
    }

    #confettiCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 9999;
    }
  </style>
</head>

<body class="dopamine-bg-pattern min-h-screen flex flex-col justify-between selection:bg-dopaYellow selection:text-dopaNavy">
  <canvas id="confettiCanvas"></canvas>

  <header class="w-full max-w-4xl mx-auto pt-6 px-4 sm:px-6">
    <div class="flex items-center justify-between pb-3 border-b-2 border-dopaNavy/15">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 bg-dopaYellow rounded-2xl border-3 border-dopaNavy flex items-center justify-center shadow-pop-sm relative animate-wiggle">
          <span class="text-2xl">✍️</span>
          <span class="absolute -top-1 -right-1 text-xs">✨</span>
        </div>
        <div>
          <span class="text-[10px] sm:text-xs font-black uppercase tracking-widest text-dopaPink bg-white px-2.5 py-0.5 rounded-full border border-dopaPink inline-block">
            ⚡ Anonymous Workshop Poll
          </span>
          <h1 class="text-lg sm:text-2xl font-black text-dopaNavy tracking-tight leading-tight">
            SMART WRITING WORKSHOP
          </h1>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button onclick="openPinModal()" class="tactile-btn px-3 py-2 rounded-xl bg-dopaPurple text-white border-2 border-dopaNavy shadow-pop-sm font-black text-xs sm:text-sm hover:bg-purple-600 flex items-center gap-1.5" title="Access Facilitator Dashboard">
          <span>🎓</span>
          <span class="hidden sm:inline">Lecturer</span>
          <span>Results</span>
        </button>
        <button id="soundToggleBtn" onclick="toggleAudio()" class="w-10 h-10 rounded-xl bg-white border-2 border-dopaNavy shadow-pop-sm flex items-center justify-center text-lg hover:bg-dopaYellow/20 transition-all tactile-btn" title="Toggle Sound FX">
          <span id="soundIcon">🔊</span>
        </button>
      </div>
    </div>

    <!-- Mode Switcher Navigation -->
    <div class="mt-4 flex justify-center">
      <div class="bg-white/90 p-1.5 rounded-2xl border-3 border-dopaNavy shadow-pop-sm inline-flex gap-2 max-w-full">
        <button id="tabFeedbackBtn" onclick="switchAppTab('feedback')" class="tactile-btn px-4 sm:px-6 py-2 rounded-xl font-heading font-black text-xs sm:text-sm transition-all flex items-center gap-2 bg-dopaPink text-white border-2 border-dopaNavy shadow-pop-sm">
          <span class="text-base sm:text-lg">✍️</span>
          <span>Workshop Feedback Poll</span>
          <span class="bg-white text-dopaPink text-[10px] px-2 py-0.5 rounded-full uppercase font-black tracking-wider">10 Soalan</span>
        </button>
        <button id="tabPopItBtn" onclick="switchAppTab('popit')" class="tactile-btn px-4 sm:px-6 py-2 rounded-xl font-heading font-black text-xs sm:text-sm transition-all flex items-center gap-2 bg-transparent text-dopaNavy/70 hover:text-dopaNavy border-2 border-transparent">
          <span class="text-base sm:text-lg">🫧</span>
          <span>Pop & Learn: Betul/Salah!</span>
        </button>
      </div>
    </div>

    <!-- Header Mood Banner -->
    <div id="feedbackHeaderBanner" class="mt-4 text-center">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-dopaNavy tracking-tight">
        How Was Your <span class="text-dopaPink underline decoration-wavy decoration-dopaYellow">Learning Journey?</span>
      </h2>
      <p class="text-xs sm:text-sm text-dopaNavy/80 font-bold mt-1 max-w-lg mx-auto">
        Tap, rate, and share your creative vibes! A quick dopamine-fuelled pulse check to help us create even more awesome experiences.
      </p>

      <div class="mt-3.5 inline-flex items-center gap-2 bg-emerald-100/90 text-emerald-950 px-4 py-2 rounded-2xl border-2 border-emerald-400 text-xs sm:text-sm font-bold shadow-sm max-w-2xl text-left">
        <span class="text-lg flex-shrink-0">🔒</span>
        <span>
          <strong class="text-emerald-900">Privacy Notice:</strong> Your feedback is anonymous. No personal identification is required. Your responses will help improve future workshops.
        </span>
      </div>
    </div>
  </header>

  <!-- ================= WORKSHOP FEEDBACK POLL VIEW ================= -->
  <main id="feedbackPollSection" class="w-full max-w-2xl mx-auto px-4 py-6 flex-grow flex flex-col justify-center">
    
    <!-- Paused Notice -->
    <div id="closedPollBanner" class="hidden mb-6 bg-red-100 border-3 border-red-500 rounded-3xl p-5 text-center shadow-pop">
      <div class="text-3xl mb-1">⏸️</div>
      <h3 class="font-heading font-black text-lg text-red-900">Poll Currently Paused</h3>
      <p class="text-xs font-bold text-red-800 mt-1">
        The facilitator has currently closed submissions. You can still view the results in the Lecturer Portal above.
      </p>
    </div>

    <!-- Progress & Mascot HUD -->
    <div id="progressContainer" class="bg-white rounded-3xl p-4 mb-6 border-3 border-dopaNavy shadow-pop">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2.5">
          <div id="mascotAvatar" class="w-11 h-11 rounded-2xl bg-dopaPink/20 border-2 border-dopaNavy flex items-center justify-center text-2xl transition-all duration-300">
            🐣
          </div>
          <div>
            <div class="text-[11px] font-black uppercase text-dopaNavy/70 tracking-wider">
              Dopamine Battery
            </div>
            <div id="questionStepText" class="text-sm font-black text-dopaNavy">
              Question 1 of 10
            </div>
          </div>
        </div>

        <div id="progressPercentBadge" class="bg-dopaYellow font-heading font-black text-dopaNavy px-3 py-1 rounded-xl border-2 border-dopaNavy text-xs sm:text-sm shadow-sm">
          0% Completed
        </div>
      </div>

      <div class="w-full h-4 bg-gray-100 rounded-full border-2 border-dopaNavy p-0.5 overflow-hidden relative">
        <div id="progressBarFill" class="h-full bg-gradient-to-r from-dopaYellow via-dopaPink to-dopaPurple rounded-full transition-all duration-500 ease-out" style="width: 10%;"></div>
      </div>
      
      <div class="flex justify-between items-center mt-2.5 pt-2 border-t border-gray-100 text-xs font-bold text-dopaNavy/70">
        <span id="sectionBadge" class="bg-dopaBlue/20 text-blue-900 px-2.5 py-0.5 rounded-lg border border-dopaBlue">
          Section 1: Vibe & Energy
        </span>
        <span id="streakCheer" class="text-dopaPink font-extrabold animate-pulse">
          ⚡ Ready to roll!
        </span>
      </div>
    </div>

    <!-- Active Question Card -->
    <div id="quizCardWrapper" class="relative">
      <div id="activeCard" class="bg-white rounded-3xl p-6 sm:p-8 border-3 border-dopaNavy shadow-pop transition-all duration-300">
        <div class="mb-5">
          <div class="flex items-center gap-2 mb-2">
            <span id="cardCategoryTag" class="text-xs font-black uppercase tracking-wider px-3 py-1 bg-dopaYellow rounded-full border border-dopaNavy">
              ⚡ Workshop Vibe
            </span>
            <span class="text-xs font-extrabold text-dopaPink bg-pink-50 px-2.5 py-0.5 rounded-full border border-pink-200">
              Compulsory *
            </span>
          </div>
          <h3 id="questionHeading" class="text-xl sm:text-2xl font-black text-dopaNavy leading-snug">
            How would you describe the overall energy and excitement in the workshop?
          </h3>
          <p id="questionHint" class="text-xs sm:text-sm font-semibold text-dopaNavy/70 mt-1">
            Pick the reaction that matches your heartbeat today:
          </p>
        </div>

        <div id="optionsContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
          <!-- Rendered dynamically -->
        </div>

        <div class="flex items-center justify-between pt-4 border-t-2 border-gray-100">
          <button id="prevBtn" onclick="handlePrevious()" class="tactile-btn px-4 py-2.5 rounded-2xl border-2 border-dopaNavy font-black text-sm bg-gray-100 text-dopaNavy hover:bg-gray-200 disabled:opacity-30 disabled:cursor-not-allowed disabled:transform-none" disabled>
            ← Back
          </button>
          
          <div class="text-xs font-bold text-dopaNavy/50 italic hidden sm:block">
            Auto-advances when selected 🚀
          </div>

          <button id="nextBtn" onclick="handleNextManual()" class="tactile-btn px-6 py-2.5 rounded-2xl border-2 border-dopaNavy font-black text-sm bg-dopaYellow text-dopaNavy shadow-pop-sm hover:bg-yellow-300 disabled:opacity-40 disabled:cursor-not-allowed disabled:transform-none" disabled>
            Next →
          </button>
        </div>
      </div>
    </div>

    <!-- Review Summary Screen -->
    <div id="summaryScreen" class="hidden bg-white rounded-3xl p-6 sm:p-8 border-3 border-dopaNavy shadow-pop animate-pop-in">
      <div class="text-center mb-6">
        <div class="w-16 h-16 bg-dopaYellow/40 rounded-3xl border-3 border-dopaNavy mx-auto flex items-center justify-center text-3xl shadow-pop-sm mb-3 animate-float">
          🎉
        </div>
        <span class="text-xs font-black uppercase tracking-widest text-dopaGreen bg-emerald-50 px-3 py-1 rounded-full border border-emerald-300">
          All 10 Questions Answered!
        </span>
        <h3 class="text-2xl sm:text-3xl font-black text-dopaNavy mt-2">
          Your Dopamine Summary
        </h3>
        <p class="text-sm text-dopaNavy/80 font-bold max-w-md mx-auto mt-1">
          Review your answers below. You can jump back to edit any question or add an optional spark before finalizing.
        </p>
      </div>

      <div id="summaryChips" class="bg-dopaCream rounded-2xl p-4 border-2 border-dopaNavy/20 mb-6 max-h-56 overflow-y-auto space-y-2 text-xs sm:text-sm">
        <!-- Rendered dynamically -->
      </div>

      <div class="bg-pink-50/70 rounded-2xl p-4 border-2 border-dopaPink/40 mb-6">
        <label for="optionalFeedback" class="block font-black text-sm text-dopaNavy mb-1 flex items-center justify-between">
          <span class="flex items-center gap-1.5">
            <span>💡</span> Drop a Spark of Thought (Optional)
          </span>
          <span class="text-xs font-bold text-dopaPink uppercase">100% Anonymous</span>
        </label>
        <p class="text-xs font-semibold text-dopaNavy/70 mb-2">
          What was your single favourite moment, or one thing we could make 10x more thrilling?
        </p>
        <textarea id="optionalFeedback" rows="3" placeholder="e.g. Loved the timed quick-write sprints! Would love even more real-time examples on catchy hooks..." class="w-full p-3 rounded-xl border-2 border-dopaNavy/30 focus:border-dopaPink focus:outline-none text-sm text-dopaNavy font-medium resize-none bg-white"></textarea>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <button onclick="goToQuestion(9)" class="tactile-btn py-3 px-5 rounded-2xl border-2 border-dopaNavy font-black text-sm bg-gray-100 text-dopaNavy hover:bg-gray-200">
          ✏️ Edit Answers
        </button>
        <button id="finalSubmitBtn" onclick="submitPoll()" class="tactile-btn flex-1 py-3.5 px-6 rounded-2xl border-3 border-dopaNavy font-black text-base bg-dopaPink text-white shadow-pop hover:bg-pink-500 flex items-center justify-center gap-2">
          <span>🚀 Submit Anonymous Feedback</span>
        </button>
      </div>
    </div>

    <!-- Success Screen -->
    <div id="successScreen" class="hidden bg-white rounded-3xl p-6 sm:p-10 border-3 border-dopaNavy shadow-pop text-center relative overflow-hidden animate-pop-in">
      <div class="relative inline-block mb-4">
        <div class="w-24 h-24 rounded-full bg-dopaYellow border-3 border-dopaNavy mx-auto flex items-center justify-center text-5xl shadow-pop animate-wiggle">
          🌟
        </div>
        <span class="absolute -bottom-1 -right-2 text-2xl animate-bounce">🎨</span>
      </div>

      <span class="inline-block bg-dopaGreen text-emerald-950 font-black text-xs uppercase tracking-wider px-3 py-1 rounded-full border-2 border-dopaNavy mb-2">
        Feedback Recorded!
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-dopaNavy tracking-tight">
        High Five, Storyteller! 🙌
      </h2>
      <p class="text-base text-dopaNavy/80 font-bold max-w-md mx-auto mt-2">
        Thank you for injecting your vibrant energy into our workshop. Your insights will directly shape upcoming writing cohorts!
      </p>

      <div class="my-6 p-5 rounded-2xl bg-gradient-to-r from-yellow-100 via-pink-100 to-purple-100 border-2 border-dopaNavy/20 max-w-md mx-auto shadow-sm">
        <div class="text-[11px] font-black uppercase text-dopaNavy/70 tracking-wider">Your Official Workshop Persona</div>
        <div id="personaResultTitle" class="text-xl font-black text-dopaNavy mt-1">
          ✨ Creative Spark Igniter ✨
        </div>
        <p id="personaResultDesc" class="text-xs font-semibold text-dopaNavy/80 mt-1">
          Ready to turn bold ideas into unforgettable stories and viral hooks!
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-lg mx-auto mt-4">
        <button onclick="openPinModal()" class="tactile-btn py-3 px-5 rounded-2xl border-2 border-dopaNavy font-black text-sm bg-dopaGreen text-emerald-950 shadow-pop-sm hover:bg-emerald-300 flex items-center justify-center gap-2">
          <span>📊 View Workshop Results</span>
        </button>
        <button onclick="shareCompletion()" class="tactile-btn py-3 px-5 rounded-2xl border-2 border-dopaNavy font-black text-sm bg-dopaBlue text-blue-950 shadow-pop-sm hover:bg-sky-300 flex items-center justify-center gap-2">
          <span>📋 Copy Mood Card</span>
        </button>
        <button onclick="restartPoll()" class="tactile-btn py-3 px-5 rounded-2xl border-2 border-dopaNavy font-black text-sm bg-white text-dopaNavy shadow-pop-sm hover:bg-gray-50 flex items-center justify-center gap-2">
          <span>🔄 Submit Another</span>
        </button>
      </div>

      <div id="toastBox" class="mt-4 hidden p-3 rounded-xl bg-dopaNavy text-white font-bold text-xs max-w-xs mx-auto animate-pulse">
        Copied to clipboard! 🌟
      </div>
    </div>
  </main>

  <!-- ================= POP & LEARN: BETUL ATAU SALAH! GAME VIEW ================= -->
  <section id="popItGameSection" class="hidden w-full max-w-3xl mx-auto px-4 py-4 flex-grow flex-col justify-center">
    
    <!-- Welcome Screen -->
    <div id="popWelcomeScreen" class="bg-white rounded-3xl p-6 sm:p-10 border-3 border-dopaNavy shadow-pop text-center animate-pop-in">
      <div class="relative inline-block mb-3">
        <div class="w-20 h-20 rounded-3xl bg-dopaYellow border-3 border-dopaNavy mx-auto flex items-center justify-center text-4xl shadow-pop animate-wiggle">
          🫧
        </div>
        <span class="absolute -top-1 -right-2 text-2xl animate-bounce">⚡</span>
      </div>

      <span class="inline-block bg-dopaBlue/20 text-blue-950 font-black text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-dopaBlue mb-2">
        Pop-It Knowledge Check
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-dopaNavy tracking-tight">
        POP & LEARN: BETUL ATAU SALAH!
      </h2>
      <p class="text-sm sm:text-base font-extrabold text-dopaPink mt-1">
        Uji kefahaman anda tentang Smart Writing Workshop
      </p>

      <div class="mt-5 p-4 rounded-2xl bg-dopaCream border-2 border-dopaNavy/20 max-w-md mx-auto text-left space-y-2 text-xs sm:text-sm font-bold text-dopaNavy">
        <div class="flex items-start gap-2">
          <span class="text-base">🎯</span>
          <span>Klik mana-mana bubble warna-warni untuk mula menjawab soalan.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-base">💡</span>
          <span>Setiap bubble akan memunculkan satu soalan <strong>Betul / Salah</strong>.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-base">🏆</span>
          <span>Jawab semua 15 soalan untuk mencatat rekod markah dan lencana dopamine anda!</span>
        </div>
      </div>

      <div class="mt-6">
        <button onclick="startPopItGame()" class="tactile-btn py-3.5 px-8 rounded-2xl border-3 border-dopaNavy font-black text-base sm:text-lg bg-dopaGreen text-emerald-950 shadow-pop hover:bg-emerald-300 inline-flex items-center gap-2">
          <span>🚀 Mula Bermain Sekarang</span>
        </button>
      </div>
    </div>

    <!-- Active Pop-It Board -->
    <div id="popBoardScreen" class="hidden flex-col items-center animate-pop-in">
      <div class="w-full bg-white rounded-2xl p-4 mb-4 border-3 border-dopaNavy shadow-pop flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-dopaYellow border-2 border-dopaNavy flex items-center justify-center text-2xl shadow-pop-sm">
            🫧
          </div>
          <div>
            <div class="text-[10px] font-black uppercase text-dopaNavy/70 tracking-wider">
              Status Pop-It
            </div>
            <div id="popAnsweredCountText" class="text-sm font-black text-dopaNavy">
              0 / 15 Selesai Dipop
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="bg-dopaCream px-3 py-1.5 rounded-xl border-2 border-dopaNavy text-xs font-black text-dopaNavy flex items-center gap-1.5">
            <span>⭐ Skor:</span>
            <span id="popScoreText" class="text-dopaPink text-sm font-black">0</span>
          </div>
          <button onclick="restartPopItGame()" class="tactile-btn px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-dopaNavy rounded-xl border-2 border-dopaNavy font-black text-xs flex items-center gap-1">
            <span>🔄</span> Mula Semula
          </button>
