    function exportCSV() {
      const submissions = getStoredSubmissions();
      if (submissions.length === 0) {
        showToast("No data to export yet!");
        return;
      }

      let csvContent = "data:text/csv;charset=utf-8,";
      const headers = ["SubmissionID", "Timestamp"];
      questions.forEach((q, idx) => {
        headers.push(`"Q${idx + 1}_${q.categoryTag.replace(/[^a-zA-Z0-9]/g, '')}"`);
        headers.push(`"Q${idx + 1}_Score"`);
      });
      headers.push('"AnonymousSpark"');
      csvContent += headers.join(",") + "\r\n";

      submissions.forEach((sub, i) => {
        const row = [i + 1, `"${sub.timestamp || 'N/A'}"`];
        questions.forEach((q, qIdx) => {
          const optIdx = sub.answers[qIdx];
          if (optIdx !== undefined && q.options[optIdx]) {
            row.push(`"${q.options[optIdx].label.replace(/"/g, '""')}"`);
            row.push(q.options[optIdx].score);
          } else {
            row.push('""');
            row.push(0);
          }
        });
        const spark = sub.optionalSpark ? `"${sub.optionalSpark.replace(/"/g, '""')}"` : '""';
        row.push(spark);
        csvContent += row.join(",") + "\r\n";
      });

      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `SmartWritingWorkshop_Feedback_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      showToast("CSV file generated and downloaded! 📥");
    }

