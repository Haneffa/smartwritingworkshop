    function triggerConfetti() {
      const canvas = document.getElementById("confettiCanvas");
      const ctx = canvas.getContext("2d");
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const pieces = [];
      const colors = ['#FFD93D', '#FF6B9A', '#6BCBFF', '#6BCB77', '#B19CFF'];
      for (let i = 0; i < 90; i++) {
        pieces.push({
          x: canvas.width / 2,
          y: canvas.height * 0.4,
          r: Math.random() * 7 + 4,
          dx: (Math.random() - 0.5) * 16,
          dy: (Math.random() - 0.7) * 16,
          color: colors[Math.floor(Math.random() * colors.length)],
          tilt: Math.random() * 10,
          tiltAngle: Math.random() * Math.PI,
          life: 100
        });
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let active = false;
        pieces.forEach(p => {
          if (p.life > 0) {
            active = true;
            p.x += p.dx;
            p.y += p.dy;
            p.dy += 0.35;
            p.life -= 1.2;
            p.tiltAngle += 0.1;
            ctx.beginPath();
            ctx.lineWidth = p.r;
            ctx.strokeStyle = p.color;
            ctx.moveTo(p.x + p.tilt, p.y);
            ctx.lineTo(p.x, p.y + p.tilt + p.r / 2);
            ctx.stroke();
          }
        });
        if (active) requestAnimationFrame(draw);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      draw();
    }

    function shareCompletion() {
      const textToCopy = `✍️ Just completed the Smart Writing Workshop Dopamine Poll! Rated the creative learning energy 10/10! 🚀 #SmartWriting #DopamineLearning`;
      
      const textArea = document.createElement("textarea");
      textArea.value = textToCopy;
      textArea.style.position = "fixed";
      textArea.style.left = "-9999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      
      try {
        document.execCommand('copy');
        showToast("Workshop Mood Card copied to clipboard! 📋✨");
      } catch (err) {
        showToast("Failed to copy card.");
      }
      document.body.removeChild(textArea);
    }

    function showToast(msg) {
      let toast = document.getElementById("globalToast");
      if (!toast) {
        toast = document.createElement("div");
        toast.id = "globalToast";
        toast.className = "fixed bottom-5 left-1/2 -translate-x-1/2 bg-dopaNavy text-white px-5 py-3 rounded-2xl border-2 border-dopaYellow font-heading font-black text-xs sm:text-sm shadow-pop z-50 transition-all duration-300 pointer-events-none";
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.style.opacity = "1";
      toast.style.transform = "translate(-50%, 0)";
      
      setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transform = "translate(-50%, 20px)";
      }, 2500);
    }

    function escapeHtml(str) {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    window.onload = function () {
      renderCurrentQuestion();
      if (getStoredSubmissions().length === 0) {
        seedDemoData();
      }
    };
  </script>
</body>
